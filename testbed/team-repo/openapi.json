"Transfer":{"type":"object","properties":{"id":{"type":"string"},"fromAccountId":{"type":"string"},"toAccountId":{"type":"string"},"amount":{"type":"number"},"status":{"type":"string","enum":["PENDING","COMPLETED","FAILED"]},"createdAt":{"type":"string","format":"date-time"}}}}}}
